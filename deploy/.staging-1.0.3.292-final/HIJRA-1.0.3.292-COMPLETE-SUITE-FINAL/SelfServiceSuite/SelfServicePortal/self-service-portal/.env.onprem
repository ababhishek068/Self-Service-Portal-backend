VITE_USE_MOCK=false
# Leave URLs and ports empty so the portal always calls the same origin
# (one Node process serves UI + /api on whatever PORT is in SelfServiceBackend/.env).
VITE_AUTH_API_URL=
VITE_AUTH_API_PORT=
VITE_BC_API_URL=
VITE_BC_API_PORT=
VITE_APP_NAME=Self Service Portal
VITE_BLOCK_DUPLICATE_PENDING_LEAVE=false
