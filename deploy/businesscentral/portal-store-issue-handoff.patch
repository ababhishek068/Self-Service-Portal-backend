+    procedure PreparePortalStoreIssue(requestNo: Code[20]; actorUserID: Code[50]) return_value: Text
+    var
+        StoreHeader: Record "Store Requistion Header";
+        StoreMgmt: Codeunit "Store Mgmt";
+    begin
+        if not StoreHeader.Get(requestNo) then
+            Error('Store requisition %1 was not found.', requestNo);
+        StoreMgmt.FillQuantityToIssue(StoreHeader);
+        StoreHeader.Get(requestNo);
+        StoreMgmt.PrepareIssueForManager(StoreHeader);
+        StoreHeader.Get(requestNo);
+        if actorUserID <> '' then
+            StoreHeader."Prepared By" := CopyStr(actorUserID, 1, MaxStrLen(StoreHeader."Prepared By"));
+        StoreHeader.Modify(true);
+        exit(Format(StoreHeader."Issue Stage"));
+    end;
+
