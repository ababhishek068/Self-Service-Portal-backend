# Copy to repo root as .env for local backend debug on this Mac:
#   cp deploy/local.env.abh-uat-vpn.example .env
#
# Requires Tailscale connected to abh-erp-m1 (100.124.82.121).
# Public 146.161.102.7:7047/7048 times out from this Mac.

PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:4000
PORTAL_STATIC_DIR=public

BC_ODATA_BASE_URL=http://100.124.82.121:7048/BC240/ODataV4/Company('ABH_UAT_LIVE')/
BC_SOAP_CODEUNIT_URL=http://100.124.82.121:7047/BC240/WS/ABH_UAT_LIVE/Codeunit/CuStaffPortal
BC_SOAP_PAGE_BASE_URL=http://100.124.82.121:7047/BC240/WS/ABH_UAT_LIVE/Page/
BC_ODATA_PAGE_BASE_URL=http://100.124.82.121:7047/BC240/WS/ABH_UAT_LIVE/Page/
BC_SOAP_NAMESPACE=urn:microsoft-dynamics-schemas/codeunit/CuStaffPortal

BC_AUTH_MODE=basic
BC_DOMAIN=
BC_NAV_USER=Admin
BC_NAV_PASSWORD=CHANGE_ME

SESSION_SECRET=change-me
JWT_SECRET=change-me
JWT_TTL_SECONDS=28800

SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
LOG_API_REQUESTS=true
LOG_BC_REQUESTS=true
BC_LOG_FILE=bc-integration.log
BC_DISCOVER_ODATA_SERVICES=false
BC_REQUEST_TIMEOUT_MS=8000
