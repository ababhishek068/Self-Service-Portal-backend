query 50025 "Registration Card"
{

    elements
    {
        dataitem(Registration_Form; "Registration Form")
        {
            column(Serial_No; "Serial No")
            {
                Caption = 'Serial Number';
            }
            column(Service_Number; "Service Number") { }

            column(Full_Names; "Full Names") { }
            column(Gender; Gender) { }
            column(Region; Region) { }
            column(Sub_Region; "Sub Region") { }
            column(Tribe; Tribe) { }
            // column(Registration_Year; "Registration Year")
            // {
            //     Caption = 'Date of Enlistment';
            // }

            column(Mean_Grade; "Mean Grade") { }
            column(Letter_No; "Letter No")
            {
                caption = 'Calling Letter No.';

            }
            column(ID_Number; "ID Number") { }
            column(Huduma_Number; "Huduma Number") { }
            column(Is_Disable; "Is Disable")
            {
                Caption = 'Is Disable(PWD)';
            }
            column(Type_of_Disability; "Type of Disability") { }
            column(Date_Of_Birth; "Date Of Birth") { }
            column(Recruitment_Center; "Recruitment Center") { }
            column(NBU; NBU) { }
            column(Date_of_Exit; "Date of Exit") { }
            column(Completion_Year; "Completion Year") { }
            column(Reason_for_Enrollment; "Reason for Enrollment") { }
            column(User_ID; "User ID")
            {
                Caption = 'Recruiting officer';
            }
            column(Nearest_Village; "Nearest Village")
            {
                caption = 'Actual Village';

            }
            column(Location_Sublocation; "Location/Sublocation") { }
            column(Chief_s_Name; "Chief's Name") { }
            column(Chief_s_Contact; "Chief's Contact") { }
            column(Assist__Chief_Name; "Assist. Chief Name") { }
            column(Assist__Chief_Contact; "Assist. Chief Contact") { }
            column(Village_Elder_Name; "Village Elder Name") { }
            column(Village_Elder_Contact; "Village Elder Contact") { }
            column(Nearest_Police_Station; "Nearest Police Station") { }
            column(Nearest_Town; "Nearest Town")
            {
                caption = 'Town';

            }
            column(Father_s_Name; "Father's Name") { }
            column(Father_Alive_Deceased; "Father Alive/Deceased") { }
            column(Father_s_Contacts; "Father's Contacts") { }
            column(Mother_s_Name; "Mother's Name") { }
            column(Mother_Alive_Deceased; "Mother Alive/Deceased") { }
            column(Mother_s_Contact; "Mother's Contact") { }
            column(Gurdian_s_Name; "Gurdian's Name") { }
            column(Gurdian_s_Contact; "Gurdian's Contact") { }
            column(Talent; Talent) { }
            column(Denomination; Denomination) { }
            column(Bank_Name; "Bank Name") { }
            column(Bank_Branch_Name; "Bank Branch Name") { }
            column(Bank_Account_No; "Bank Account No") { }
            column(Training_College; "Training College")
            {
                caption = 'Paramilitary Academy';

            }
            column(Brigade; Brigade) { }
            column(Barrack; Barrack) { }
            column(First_Choice_Programme; "First Choice Programme") { }
            column(Second_Choice_Programme; "Second Choice Programme") { }
            column(Third_Choice_Programme; "Third Choice Programme") { }
            column(Approved_Programme; "Approved Programme") { }
            column(Exit_Mode; "Exit Mode") { }
            column(Status; Status) { }
            column(Current_Station; "Current Station") { }
            column(Current_Main_Duty; "Current Main Duty") { }
            column(Current_Sub_Duty; "Current Sub Duty") { }
            column(Discharge_Reason; "Discharge Reason") { }
            column(Cohort; Cohort) { }
            column(Staff_No; "Staff No") { }
            column(Paramilitary_Academy; "Paramilitary Academy") { }
        }
    }
}

