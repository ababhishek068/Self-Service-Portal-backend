Query 50055 "HR Job Requirements"
{

    elements
    {
        dataitem(HR_Job_Requirements; "HR Jobs Requirements")
        {
            column(Job_ID; "Job ID") { }
            column(Qualification_Type; "Qualification Type") { }
            column(Qualification_Code; "Qualification Code") { }
            column(Priority; Priority) { }
            column(Score_ID; "Score ID") { }
            column(Need_code; "Need code") { }
            column(Stage_Code; "Stage Code") { }
            column(Mandatory; Mandatory) { }
            column(Minimum_Score; "Minimum Score") { }
            column(Total_Stage_Desired_Score; "Total (Stage)Desired Score") { }
            column(Qualification_Description; "Qualification Description") { }
            column(Maximum_Score; "Maximum Score") { }
            column(Qualification_Category; "Qualification Category") { }
            column(Category; Category) { }
            column(Qualification_Rank; "Qualification Rank") { }
        }
    }
}

