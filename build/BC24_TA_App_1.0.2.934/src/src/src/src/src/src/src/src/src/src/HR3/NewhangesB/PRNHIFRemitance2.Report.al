        //AppliedFilters
        if "HR-Employee".GetFilters = '' then begin
            AppliedFilters := '';
        end else begin
            AppliedFilters := 'APPLIED FILTERS(s) ' + "HR-Employee".GetFilters;
        end;

    end;

    var
        CompInfo: Record "Company Information";
